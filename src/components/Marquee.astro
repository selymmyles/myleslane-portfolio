---
const phrases = [
  "Hello, I’m Myles",
  "Hola, soy Myles",
  "Bonjour, je suis Myles",
  "Olá, eu sou o Myles",
  "Ciao, sono Myles",
  "Hallo, ich bin Myles",
  "こんにちは、Myles です",
  "안녕, 나는 Myles",
  "Привет, я Myles",
  "नमस्ते, मैं Myles",
];
// One rendered phrase string; duplicated into two spans so the -50% loop is seamless.
const line = phrases.join("  ✦  ") + "  ✦  ";
---

<aside aria-label="Multilingual greeting" class="marquee">
  <div class="marquee-track">
    <span>{line}</span>
    <span aria-hidden="true">{line}</span>
  </div>
</aside>

<style>
  .marquee {
    width: 100%;
    overflow: hidden;
    background: var(--color-navy);
    color: var(--color-cream);
    border-bottom: 1px solid var(--color-navy-rule);
  }
  .marquee-track {
    display: flex;
    white-space: nowrap;
    width: max-content;
    padding-block: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    animation: marquee-scroll 60s linear infinite;
    /* Promote to its own GPU layer so the scroll stays smooth and isn't
       tied to main-thread repaints. */
    will-change: transform;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
