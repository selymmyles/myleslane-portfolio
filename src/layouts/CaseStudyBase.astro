---
import "../styles/global.css";
import Marquee from "../components/Marquee.astro";

interface Props {
  title?: string;
  description?: string;
  label: string;
}

const {
  title = "Myles Lane — Case Study",
  description = "A product design case study by Myles Lane.",
  label,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh">
    <Marquee />

    <!-- NAV -->
    <div class="cs-nav">
      <div class="cs-nav-inner">
        <div class="cs-crumb">
          <a href="/" class="cs-logo">ML</a>
          <span class="cs-slash">/</span>
          <span class="cs-label">{label}</span>
        </div>
        <div class="cs-nav-actions">
          <a href="/#work" class="cs-allwork">← All work</a>
          <a href="mailto:myleslane00@gmail.com" class="cs-email-btn">Email</a>
        </div>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="cs-footer">
      <div class="cs-footer-inner">
        <a href="/#work" class="cs-back">← Back to all work</a>
        <h2 class="cs-footer-heading">Want the full walkthrough? Let’s talk.</h2>
        <a href="mailto:myleslane00@gmail.com" class="cs-footer-btn">myleslane00@gmail.com →</a>
        <div class="cs-footer-bottom">
          <div class="cs-footer-links">
            <a href="/#work">Projects</a>
            <a href="/#about">About</a>
            <a href="/resume.pdf" target="_blank" rel="noopener">Résumé</a>
            <a href="https://www.linkedin.com/in/myleslane00" target="_blank" rel="noopener">LinkedIn</a>
          </div>
          <div class="cs-copyright">© {new Date().getFullYear()} Myles Lane</div>
        </div>
      </div>
    </footer>

    <script>
      // Reliable muted autoplay for the case-study demo videos.
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll("video[autoplay]").forEach((v) => {
        v.muted = true;
        if (!reduceMotion) v.play().catch(() => {});
      });
    </script>

    <style>
      .cs-nav {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgb(242 238 223 / 0.86);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--color-navy-rule);
      }
      .cs-nav-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 40px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .cs-crumb {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
      }
      .cs-logo {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 24px;
        letter-spacing: -0.02em;
        color: var(--color-navy);
      }
      .cs-slash {
        color: rgb(23 36 63 / 0.3);
      }
      .cs-label {
        font-family: var(--font-mono);
        font-size: 12.5px;
        letter-spacing: 0.04em;
        color: var(--color-navy-faint);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .cs-nav-actions {
        display: flex;
        align-items: center;
        gap: 26px;
        font-size: 15px;
        font-weight: 500;
      }
      .cs-allwork {
        color: var(--color-navy);
        white-space: nowrap;
      }
      .cs-email-btn {
        background: var(--color-navy);
        color: var(--color-cream);
        padding: 9px 16px;
        border-radius: 9px;
        font-weight: 600;
      }
      .cs-email-btn:hover {
        background: var(--color-accent);
        color: var(--color-cream);
      }

      .cs-footer {
        width: 100%;
        background: var(--color-navy);
        color: var(--color-cream);
      }
      .cs-footer-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 72px 40px 36px;
      }
      .cs-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 12.5px;
        letter-spacing: 0.06em;
        color: rgb(242 238 223 / 0.7);
        margin-bottom: 26px;
      }
      .cs-back:hover {
        color: var(--color-cream);
      }
      .cs-footer-heading {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(30px, 4.4vw, 52px);
        letter-spacing: -0.025em;
        line-height: 1.05;
        margin: 0 0 28px;
        max-width: 18ch;
      }
      .cs-footer-btn {
        display: inline-block;
        background: var(--color-cream);
        color: var(--color-navy);
        padding: 14px 26px;
        border-radius: 11px;
        font-weight: 600;
        font-size: 16px;
      }
      .cs-footer-btn:hover {
        background: var(--color-accent);
        color: var(--color-cream);
      }
      .cs-footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-top: 60px;
        padding-top: 24px;
        border-top: 1px solid rgb(242 238 223 / 0.18);
        font-size: 14px;
      }
      .cs-footer-links {
        display: flex;
        gap: 26px;
      }
      .cs-footer-links a {
        color: rgb(242 238 223 / 0.78);
      }
      .cs-footer-links a:hover {
        color: var(--color-cream);
      }
      .cs-copyright {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: rgb(242 238 223 / 0.5);
      }

      @media (max-width: 600px) {
        .cs-nav-inner,
        .cs-footer-inner {
          padding-left: 22px;
          padding-right: 22px;
        }
        .cs-nav-actions {
          gap: 16px;
        }
      }
    </style>
  </body>
</html>
