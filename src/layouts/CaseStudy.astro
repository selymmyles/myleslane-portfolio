---
import Base from "./Base.astro";

interface Props {
  title: string;
  tagline?: string;
  subtitle?: string;
  role: string;
  year: string;
  timeline?: string;
  tools?: string;
  hero?: string;
  heroBg?: string;
  heroAlt?: string;
  titleClass?: string;
}

const props = Astro.props.frontmatter ?? Astro.props;
const {
  title,
  tagline,
  subtitle,
  role,
  year,
  timeline,
  tools,
  hero,
  heroBg,
  heroAlt,
  titleClass = "",
} = props;
---

<Base title={`${title} — Myles Lane`} description={tagline} bodyClass="theme-case-study">
  <a href="/#work" class="text-sm opacity-60 hover:opacity-100">← Back to work</a>

  <header class="mt-12 text-center">
    <h1 class={`font-display text-5xl font-bold tracking-tight sm:text-6xl ${titleClass}`}>{title}</h1>
    {subtitle && <p class="mt-2 font-display text-3xl font-light tracking-tight sm:text-4xl">{subtitle}</p>}
    {tagline && <p class="mx-auto mt-6 max-w-xl text-base opacity-80">{tagline}</p>}
  </header>

  {hero && (
    <figure class="mt-10" style={heroBg ? `background-color: ${heroBg}; padding: 3rem 2rem; border-radius: 0.75rem;` : ""}>
      <img src={hero} alt={heroAlt ?? `${title} hero`} class="mx-auto block w-full max-w-2xl" loading="eager" />
    </figure>
  )}

  <dl class="mt-12 grid grid-cols-3 gap-x-6 gap-y-3 text-center text-sm">
    {timeline && (
      <div>
        <dt class="font-semibold">Timeline</dt>
        <dd class="mt-1 opacity-70">{timeline}</dd>
      </div>
    )}
    <div>
      <dt class="font-semibold">Role</dt>
      <dd class="mt-1 opacity-70" set:html={role.replace(/ · /g, "<br />")} />
    </div>
    {tools && (
      <div>
        <dt class="font-semibold">Tools</dt>
        <dd class="mt-1 opacity-70" set:html={tools.replace(/ · /g, "<br />")} />
      </div>
    )}
  </dl>

  <article class="case-study mt-20">
    <slot />
  </article>

  <footer class="mt-20 border-t border-current/10 pt-8 text-sm opacity-70">
    <p>
      Thanks for taking a look —{" "}
      <a href="mailto:myleslane00@gmail.com" class="underline">reach me here</a>.
    </p>
  </footer>
</Base>

<style is:global>
  body.theme-case-study .case-study h2 {
    margin-top: 5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-bondit-ink);
  }
  body.theme-case-study .case-study h3 {
    margin-top: 0.25rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  body.theme-case-study .case-study p {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.85;
  }
  body.theme-case-study .case-study p strong {
    font-weight: 600;
    opacity: 1;
  }
  body.theme-case-study .case-study figure {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  body.theme-case-study .case-study figure img {
    width: 100%;
  }
  body.theme-case-study .case-study figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    opacity: 0.55;
    text-align: center;
  }
  body.theme-case-study .case-study ul,
  body.theme-case-study .case-study ol {
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding-left: 1.25rem;
  }
  body.theme-case-study .case-study li {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.55;
    opacity: 0.85;
  }
  body.theme-case-study .case-study blockquote {
    margin: 2rem 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    text-align: center;
    letter-spacing: -0.005em;
  }

  /* Reusable case-study layout primitives */
  body.theme-case-study .cs-eyebrow {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-bondit-ink);
  }
  body.theme-case-study .cs-heading {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  body.theme-case-study .cs-section {
    margin-top: 5rem;
  }
  body.theme-case-study .cs-tile {
    background-color: var(--color-bondit-clay);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }
  body.theme-case-study .cs-tile-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    text-align: center;
  }
  body.theme-case-study .cs-tile-body {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.55;
    text-align: center;
    opacity: 0.85;
  }
  body.theme-case-study .cs-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 1.5rem;
  }
  @media (max-width: 640px) {
    body.theme-case-study .cs-two-col {
      grid-template-columns: 1fr;
    }
  }
  body.theme-case-study .cs-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 640px) {
    body.theme-case-study .cs-grid-3 {
      grid-template-columns: 1fr;
    }
  }
  body.theme-case-study .cs-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 640px) {
    body.theme-case-study .cs-grid-2 {
      grid-template-columns: 1fr;
    }
  }
  body.theme-case-study .cs-stat {
    text-align: center;
    margin: 2.5rem 0;
  }
  body.theme-case-study .cs-stat-number {
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 700;
    color: var(--color-bondit-pumpkin);
    line-height: 1;
  }
  body.theme-case-study .cs-stat-label {
    margin-top: 1rem;
    font-size: 0.95rem;
    opacity: 0.85;
    max-width: 30rem;
    margin-left: auto;
    margin-right: auto;
  }
  body.theme-case-study .cs-callout-tile {
    background-color: var(--color-bondit-clay);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  body.theme-case-study .cs-callout-tile h4 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
  }
  body.theme-case-study .cs-callout-tile p {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  body.theme-case-study .cs-color-tile {
    border-radius: 0.5rem;
    padding: 1.25rem;
    min-height: 5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  body.theme-case-study .cs-color-tile .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }
  body.theme-case-study .cs-color-tile .hex {
    font-size: 0.8rem;
    opacity: 0.75;
  }
  body.theme-case-study .cs-takeaway-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 640px) {
    body.theme-case-study .cs-takeaway-grid {
      grid-template-columns: 1fr;
    }
  }
  body.theme-case-study .cs-takeaway h4 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }
  body.theme-case-study .cs-problem-card {
    background-color: #ffffff;
    border-radius: 0.75rem;
    padding: 1.5rem 1.75rem;
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    align-items: flex-start;
  }
  body.theme-case-study .cs-problem-card .icon {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    background-color: var(--color-linkedin-blue);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }
  body.theme-case-study .cs-problem-card h4 {
    font-family: var(--font-display);
    font-weight: 600;
    display: inline;
  }
  body.theme-case-study .cs-problem-card p {
    display: inline;
    font-size: 0.9rem;
    opacity: 0.85;
  }
</style>
