---
import "../styles/global.css";
import Marquee from "../components/Marquee.astro";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  marquee?: boolean;
  footerCta?: boolean;
}

const {
  title = "Myles Lane — Product Designer",
  description = "Product Designer at Goldman Sachs focused on making complex tools feel simple.",
  bodyClass = "",
  marquee = false,
  footerCta = true,
} = Astro.props;

// Cloudflare Web Analytics token — set PUBLIC_CF_BEACON_TOKEN in the Cloudflare
// project's environment variables to switch analytics on (no-op until then).
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://myleslane.com" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class={`min-h-dvh ${bodyClass}`}>
    {marquee && <Marquee />}

    <!-- NAV -->
    <div class="site-nav">
      <div class="site-nav-inner">
        <a href="/" class="site-logo">ML</a>
        <nav class="site-links">
          <a href="/#work">Work</a>
          <a href="/#about">About</a>
          <a href="/resume.pdf" class="nav-secondary" target="_blank" rel="noopener">CV</a>
          <a href="https://www.linkedin.com/in/myleslane00" class="nav-secondary" target="_blank" rel="noopener">LinkedIn</a>
          <a href="mailto:myleslane00@gmail.com" class="site-email-btn">Email</a>
        </nav>
      </div>
    </div>

    <main class="site-main">
      <slot />
    </main>

    {footerCta && (
      <footer class="site-footer">
        <div class="site-footer-inner">
          <div class="footer-eyebrow">Get in touch</div>
          <h2 class="footer-heading">Let’s make something good together.</h2>
          <a href="mailto:myleslane00@gmail.com" class="footer-cta-btn">myleslane00@gmail.com →</a>
          <div class="footer-bottom">
            <div class="footer-bottom-links">
              <a href="/#work">Work</a>
              <a href="/#about">About</a>
              <a href="/resume.pdf" target="_blank" rel="noopener">CV</a>
              <a href="https://www.linkedin.com/in/myleslane00" target="_blank" rel="noopener">LinkedIn</a>
            </div>
            <div class="footer-copyright">© {new Date().getFullYear()} Myles Lane</div>
          </div>
        </div>
      </footer>
    )}

    <script>
      // Reliable muted autoplay (the `muted` attribute alone is often ignored).
      // Respect reduced-motion: leave the video paused on its first frame.
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll("video[autoplay]").forEach((v) => {
        v.muted = true;
        if (!reduceMotion) v.play().catch(() => {});
      });
    </script>

    {/* Cloudflare Web Analytics — privacy-first (no cookies, no consent banner) */}
    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
      ></script>
    )}

    <style>
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgb(242 238 223 / 0.86);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--color-navy-rule);
      }
      .site-nav-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 40px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .site-logo {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 24px;
        letter-spacing: -0.02em;
        color: var(--color-navy);
      }
      .site-links {
        display: flex;
        align-items: center;
        gap: 30px;
        font-size: 15px;
        font-weight: 500;
      }
      .site-links a {
        color: var(--color-navy);
      }
      .site-links a.site-email-btn {
        background: var(--color-navy);
        color: var(--color-cream);
        padding: 9px 16px;
        border-radius: 9px;
        font-weight: 600;
      }
      .site-links a.site-email-btn:hover {
        background: var(--color-accent);
        color: var(--color-cream);
      }

      .site-main {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 40px;
      }

      .site-footer {
        width: 100%;
        background: var(--color-navy);
        color: var(--color-cream);
      }
      .site-footer-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 80px 40px 36px;
      }
      .footer-eyebrow {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: 18px;
      }
      .footer-heading {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(32px, 4.6vw, 56px);
        letter-spacing: -0.025em;
        line-height: 1.04;
        margin: 0 0 30px;
        max-width: 16ch;
      }
      .footer-cta-btn {
        display: inline-block;
        background: var(--color-cream);
        color: var(--color-navy);
        padding: 14px 26px;
        border-radius: 11px;
        font-weight: 600;
        font-size: 16px;
      }
      .footer-cta-btn:hover {
        background: var(--color-accent);
        color: var(--color-cream);
      }
      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-top: 64px;
        padding-top: 24px;
        border-top: 1px solid rgb(242 238 223 / 0.18);
        font-size: 14px;
      }
      .footer-bottom-links {
        display: flex;
        gap: 26px;
      }
      .footer-bottom-links a {
        color: rgb(242 238 223 / 0.78);
      }
      .footer-bottom-links a:hover {
        color: var(--color-cream);
      }
      .footer-copyright {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: rgb(242 238 223 / 0.5);
      }

      @media (max-width: 640px) {
        .site-nav-inner,
        .site-main,
        .site-footer-inner {
          padding-left: 22px;
          padding-right: 22px;
        }
        .site-links {
          gap: 18px;
          font-size: 15px;
        }
        .nav-secondary {
          display: none;
        }
      }
    </style>
  </body>
</html>
