---
import Base from "../layouts/Base.astro";
---

<Base title="About — Myles Lane" marquee={true}>
  <a href="/" class="text-sm text-[var(--color-navy-muted)]">← Back</a>

  <header class="mt-10 space-y-5">
    <p class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--color-navy-subtle)]">About</p>
    <h1 class="text-4xl font-medium leading-[1.1] tracking-tight sm:text-5xl md:text-[3.25rem]">
      Hi, I'm Myles.
    </h1>
  </header>

  <figure class="mt-12 sm:mt-16">
    <img
      src="/site-assets/images/SdHCQK8xg4nfGfsmpL8xSARysDE.png"
      alt="A duotone self-portrait illustration of Myles, drawn in navy and sage"
      class="block w-full max-w-md"
      loading="eager"
    />
  </figure>

  <section class="mt-16 max-w-2xl space-y-6 text-lg leading-relaxed sm:text-[1.2rem]">
    <p>
      Hey there! I'm Myles, a Product Designer at Goldman Sachs on the Human Capital Management
      team. I design internal tools used by groups across the firm — recruiting, rewards, firm-wide
      operations — built on the firm's enterprise design system.
    </p>
    <p>
      I came into product from an animation background (BFA from SCAD, Story & Concept), which
      still shows up in how I think about motion, hierarchy, and visual polish. Outside of GS, I
      shipped a 0-to-1 CRM and design system for Tiberon Systems and designed the UI for Pixel
      Arena, the 1st-place winner at the DSCVR Buildathon.
    </p>
    <p>
      Right now I'm focused on AI product design — using Figma Make and other AI-augmented tools
      in my workflow at GS, plus side projects exploring how AI features can stay clear,
      trustworthy, and human-centered.
    </p>
    <p>
      I work across the full stack of product design — research, interaction design, prototyping,
      design systems, accessibility — with a particular interest in generative AI interfaces and
      the patterns that make them work. Comfortable across enterprise, B2B SaaS, and consumer
      surfaces.
    </p>
  </section>

  <section class="mt-32 sm:mt-40">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      Get in touch.
    </h2>
    <p class="mt-8 max-w-2xl text-lg text-[var(--color-navy-muted)]">
      Best way to reach me is{" "}
      <a href="mailto:myleslane00@gmail.com" class="underline decoration-1 underline-offset-4">email</a>
      {" "}or{" "}
      <a href="https://www.linkedin.com/in/myleslane00/" class="underline decoration-1 underline-offset-4">LinkedIn</a>.
    </p>
  </section>
</Base>
