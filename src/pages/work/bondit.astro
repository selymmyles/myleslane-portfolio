---
import CaseStudyBase from "../../layouts/CaseStudyBase.astro";
const B = "/case-studies/bondit";
---

<CaseStudyBase
  title="Bondit — Case Study | Myles Lane"
  description="Bondit: a habit-tracking app that turns self-improvement into something you do with your friends. UX research, IA, and UI design case study."
  label="Bondit case study"
>
  <!-- HERO -->
  <section class="cs-wrap" style="padding:72px 40px 0;">
    <div style="display:flex;align-items:center;gap:12px;font-family:var(--font-mono);font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent);margin-bottom:24px;">
      <span style="width:9px;height:9px;border-radius:50%;background:#E8743B;display:inline-block;"></span>Case Study — Mobile App
    </div>
    <h1 style="font-family:var(--font-display);font-weight:700;font-size:clamp(48px,8vw,104px);line-height:.94;letter-spacing:-.035em;margin:0 0 20px;">bondit</h1>
    <p style="font-size:22px;line-height:1.5;color:var(--color-navy-strong);max-width:48ch;margin:0 0 40px;font-weight:500;">Strengthen bonds through sharing habits, a habit-tracking app that turns self-improvement into something you do <em>with</em> your friends.</p>

    <div style="display:flex;flex-wrap:wrap;gap:48px;padding:26px 0 0;border-top:1px solid rgb(23 36 63 / .16);">
      <div><div class="cs-meta-k">Timeline</div><div class="cs-meta-v">4 months</div></div>
      <div><div class="cs-meta-k">Role</div><div class="cs-meta-v">UX &amp; UI Designer · Researcher</div></div>
      <div><div class="cs-meta-k">Team</div><div class="cs-meta-v">Solo project</div></div>
      <div><div class="cs-meta-k">Tools</div><div class="cs-meta-v">Figma · Miro</div></div>
      <div><div class="cs-meta-k">Focus</div><div class="cs-meta-v">Habits · Social · Journaling</div></div>
    </div>
  </section>

  <!-- HERO VISUAL -->
  <section class="cs-wrap" style="padding:48px 40px 40px;">
    <div style="border-radius:24px;background:radial-gradient(120% 120% at 50% 0%,#E78457,#D9663B);overflow:hidden;display:flex;justify-content:center;align-items:center;padding:28px clamp(20px,4vw,52px);">
      <img src={`${B}/hero-phones.png`} alt="Bondit app — three phone screens" style="width:min(78%,640px);display:block;filter:drop-shadow(0 24px 40px rgba(23,36,63,.34));" />
    </div>
  </section>

  <!-- OUTCOME — results up front -->
  <section class="cs-wrap" style="padding:0 40px 80px;">
    <div class="cs-eyebrow" style="margin-bottom:18px;">Outcome</div>
    <div style="display:flex;flex-wrap:wrap;gap:28px 56px;">
      <div style="min-width:150px;">
        <div style="font-family:var(--font-display);font-weight:800;font-size:clamp(38px,4.6vw,52px);line-height:1;color:var(--color-accent);">100%</div>
        <div style="font-size:14px;line-height:1.45;color:var(--color-navy-strong);margin-top:8px;max-width:26ch;">task completion in final moderated usability testing</div>
      </div>
      <div style="min-width:150px;">
        <div style="font-family:var(--font-display);font-weight:800;font-size:clamp(38px,4.6vw,52px);line-height:1;color:var(--color-navy);">60%</div>
        <div style="font-size:14px;line-height:1.45;color:var(--color-navy-strong);margin-top:8px;max-width:26ch;">lift in usability ratings, pre- vs post-redesign</div>
      </div>
      <div style="min-width:150px;">
        <div style="font-family:var(--font-display);font-weight:800;font-size:clamp(38px,4.6vw,52px);line-height:1;color:var(--color-accent);">4–5<span style="font-size:.5em;font-weight:700;">/5</span></div>
        <div style="font-size:14px;line-height:1.45;color:var(--color-navy-strong);margin-top:8px;max-width:26ch;">intuitiveness from participants, consistently</div>
      </div>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="cs-wrap cs-divide" style="padding:48px 40px 80px;">
    <div class="cs-grid-overview">
      <div>
        <div class="cs-eyebrow" style="margin-bottom:10px;">(01) — Overview</div>
        <div style="font-family:var(--font-display);font-weight:600;font-size:24px;letter-spacing:-.02em;">The opportunity</div>
      </div>
      <p style="font-size:20px;line-height:1.62;color:var(--color-navy);margin:0;max-width:62ch;">Self-improvement and habit formation are increasingly popular among young people, but staying consistent is hard, and most people only have themselves for motivation. I designed a habit-tracking app that uses social interactivity to make habit-building collaborative and genuinely enjoyable. By turning habits into shared goals with friends, the process becomes something to look forward to rather than a chore.</p>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="cs-wrap cs-divide" style="padding:48px 40px 80px;">
    <div class="cs-eyebrow">(02) — The problem</div>
    <h2 class="cs-h2" style="margin:0 0 32px;max-width:20ch;">Going it alone rarely sticks</h2>
    <div class="cs-problem-2">
      <p style="font-size:19px;line-height:1.6;color:var(--color-navy);margin:0;">Young adults trying to self-improve and form new habits struggle to stay consistent and hold themselves accountable when they’re the only source of motivation. Without connection or stakes, momentum fades fast, and most habit apps do nothing to fix it.</p>
      <div style="background:var(--color-navy);color:var(--color-cream);border-radius:18px;padding:36px;">
        <div style="font-family:var(--font-display);font-weight:800;font-size:72px;line-height:1;color:#E78457;">2×</div>
        <div style="font-size:15px;line-height:1.5;margin-top:12px;color:rgb(242 238 223 / .82);">more likely to reach a goal when you share weekly progress with a friend — 70% succeed, versus 35% going it alone. <span style="color:rgb(242 238 223 / .5);">(Dr. Gail Matthews, Dominican University)</span></div>
      </div>
    </div>
  </section>

  <!-- SOLUTION INTRO -->
  <section class="cs-wrap cs-divide" style="padding:48px 40px 24px;">
    <div class="cs-eyebrow">(03) — The solution</div>
    <h2 class="cs-h2" style="margin:0 0 16px;max-width:18ch;">Leveraging social connection</h2>
    <p style="font-size:18px;line-height:1.6;color:var(--color-navy-strong);margin:0;max-width:60ch;">Bondit helps users build healthy habits with friends by creating “bonds”, groups around a shared habit where friends snap a daily photo to keep the streak alive. Accountability that feels like staying in touch, not a chore.</p>
  </section>

  <!-- KEY DECISION -->
  <section class="cs-wrap" style="padding:28px 40px 0;">
    <div style="border-left:3px solid var(--color-accent);padding:4px 0 4px 26px;max-width:64ch;">
      <div class="cs-eyebrow" style="margin-bottom:12px;">The pivotal decision</div>
      <p style="font-family:var(--font-display);font-weight:600;font-size:clamp(21px,2.6vw,28px);line-height:1.32;letter-spacing:-.012em;color:var(--color-navy);margin:0;">The biggest unlock wasn’t a screen — it was a word. Research kept pointing to the same thing, so I renamed <em style="font-style:italic;">Habits</em> to <em style="font-style:italic;color:var(--color-accent);">Bonds</em> and rebuilt the app around what happens <em style="font-style:italic;">between</em> people, not just within them.</p>
    </div>
  </section>

  <!-- FEATURE 1 -->
  <section class="cs-wrap" style="padding:40px 40px 0;">
    <div class="cs-grid-2">
      <div>
        <div class="cs-eyebrow" style="margin-bottom:10px;letter-spacing:.14em;">Feature 01</div>
        <h3 class="cs-h3" style="font-size:28px;margin:0 0 14px;">Strengthen bonds with shared habits</h3>
        <p style="font-size:16.5px;line-height:1.6;color:var(--color-navy-strong);margin:0;">The Bonds page is where you and friends build lasting habits together, create groups, set shared goals, and track progress by snapping photos to keep streaks alive. Personal and group streak stats sit up top for motivation, with friends, bond groups, and galleries of captured moments below.</p>
      </div>
      <div style="border-radius:22px;padding:28px 24px;background:radial-gradient(120% 100% at 50% 0%,#E78457,#D9663B);display:flex;justify-content:center;">
        <img src={`${B}/social.png`} alt="Bondit profile and feed screens" class="cs-tile-img" style="filter:drop-shadow(0 22px 44px rgba(23,36,63,.34));" />
      </div>
    </div>
  </section>

  <!-- FEATURE 2 (image left) -->
  <section class="cs-wrap" style="padding:64px 40px 0;">
    <div class="cs-grid-2 cs-feature-rev">
      <div class="cs-feature-media" style="border-radius:22px;padding:28px 24px;background:radial-gradient(120% 100% at 50% 0%,#22345B,#17243F);display:flex;justify-content:center;">
        <img src={`${B}/journal.png`} alt="Bondit New Entry and Journal screens" class="cs-tile-img" style="filter:drop-shadow(0 22px 44px rgba(0,0,0,.34));" />
      </div>
      <div class="cs-feature-copy">
        <div class="cs-eyebrow" style="margin-bottom:10px;letter-spacing:.14em;">Feature 02</div>
        <h3 class="cs-h3" style="font-size:28px;margin:0 0 14px;">Journaling for flexible progress</h3>
        <p style="font-size:16.5px;line-height:1.6;color:var(--color-navy-strong);margin:0;">Daily habit tracking isn’t the only way to measure progress. User interviews showed many people journal alongside or instead of tracking. Bondit lets you write, tag, and filter journal entries, then share them with friends or keep them private.</p>
      </div>
    </div>
  </section>

  <!-- FEATURE 3 -->
  <section class="cs-wrap" style="padding:64px 40px 80px;">
    <div class="cs-grid-2">
      <div>
        <div class="cs-eyebrow" style="margin-bottom:10px;letter-spacing:.14em;">Feature 03</div>
        <h3 class="cs-h3" style="font-size:28px;margin:0 0 14px;">Stay connected with your community</h3>
        <p style="font-size:16.5px;line-height:1.6;color:var(--color-navy-strong);margin:0;">Your Bonds bring every shared habit into one place, and each one carries its own streak, photo posts, and group chat. An Activity feed ties it all together, surfacing every like, comment, and bond invite, so you never miss a moment with your people.</p>
      </div>
      <div style="border-radius:22px;padding:28px 24px;background:radial-gradient(120% 100% at 50% 0%,#E78457,#D9663B);display:flex;justify-content:center;">
        <img src={`${B}/community.png`} alt="Bondit Bonds, Bond detail, and Activity screens" class="cs-tile-img" style="filter:drop-shadow(0 22px 44px rgba(23,36,63,.34));" />
      </div>
    </div>
  </section>

  <!-- RESEARCH -->
  <section class="cs-wrap cs-divide" style="padding:48px 40px 80px;">
    <div class="cs-eyebrow">(04) — Research</div>
    <h2 class="cs-h2" style="margin:0 0 40px;">Understanding the problem space</h2>

    <div class="cs-grid-3" style="margin-bottom:56px;">
      <div class="cs-info-card">
        <div style="font-weight:700;font-size:17px;margin-bottom:8px;">Technical analysis</div>
        <p class="cs-info-p">Assessed existing habit-tracking apps to find their weak points, especially around the social aspects, and where Bondit could improve.</p>
      </div>
      <div class="cs-info-card">
        <div style="font-weight:700;font-size:17px;margin-bottom:8px;">Secondary research</div>
        <p class="cs-info-p">Reviewed scientific evidence for social motivation in building and maintaining habits, backing the hypothesis that social interactivity drives consistency.</p>
      </div>
      <div class="cs-info-card">
        <div style="font-weight:700;font-size:17px;margin-bottom:8px;">Primary research</div>
        <p class="cs-info-p">One-on-one interviews with five participants across different areas of habit formation, to understand real motivations, challenges, and strategies.</p>
      </div>
    </div>

    <div style="background:var(--color-navy);color:var(--color-cream);border-radius:20px;padding:clamp(28px,4vw,48px);margin-bottom:48px;display:flex;flex-wrap:wrap;gap:40px;align-items:center;">
      <div style="text-align:center;">
        <div style="font-family:var(--font-display);font-weight:800;font-size:80px;line-height:1;color:#E78457;">5</div>
        <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:rgb(242 238 223 / .6);margin-top:6px;">interviews</div>
      </div>
      <div style="flex:1;min-width:260px;font-family:var(--font-display);font-weight:600;font-size:clamp(20px,2.4vw,28px);line-height:1.25;letter-spacing:-.01em;">“Social motivation plays a key role in habit formation and consistency.”</div>
    </div>

    <div style="font-family:var(--font-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--color-navy-subtle);margin-bottom:20px;">Key insights</div>
    <div class="cs-grid-3">
      <div>
        <div class="cs-insight-n">01</div>
        <div style="font-weight:700;font-size:17px;margin-bottom:8px;">Social accountability boosts consistency</div>
        <p class="cs-info-p">Involving friends or groups created a sense of obligation and motivation, from rock climbing together to small spiritual-practice groups.</p>
      </div>
      <div>
        <div class="cs-insight-n">02</div>
        <div style="font-weight:700;font-size:17px;margin-bottom:8px;">Journaling is essential</div>
        <p class="cs-info-p">Most participants used casual journaling as their primary tracking method, a surprise that reshaped the app away from pure habit tracking.</p>
      </div>
      <div>
        <div class="cs-insight-n">03</div>
        <div style="font-weight:700;font-size:17px;margin-bottom:8px;">It has to be intuitive &amp; fun</div>
        <p class="cs-info-p">Past apps felt unintuitive and unengaging. Users wanted something familiar, closer to BeReal, Snapchat, Instagram, and TikTok.</p>
      </div>
    </div>
  </section>

  <!-- USER NEEDS -->
  <section class="cs-wrap cs-divide" style="padding:48px 40px 80px;">
    <div class="cs-eyebrow">User needs</div>
    <h2 class="cs-h2" style="font-size:clamp(26px,3.2vw,36px);margin:0 0 36px;max-width:24ch;">What the research told me to build</h2>
    <div class="cs-grid-3" style="gap:28px;">
      <div style="border-top:3px solid var(--color-accent);padding-top:18px;">
        <div style="font-weight:700;font-size:19px;margin-bottom:8px;">Journaling</div>
        <p class="cs-info-p" style="font-size:15px;">Users want journaling as their preferred way to keep track, so it had to be a first-class part of the design.</p>
      </div>
      <div style="border-top:3px solid var(--color-navy);padding-top:18px;">
        <div style="font-weight:700;font-size:19px;margin-bottom:8px;">Social integration</div>
        <p class="cs-info-p" style="font-size:15px;">Social features need to run throughout the app to make habit-forming more enjoyable, not bolted on.</p>
      </div>
      <div style="border-top:3px solid var(--color-accent);padding-top:18px;">
        <div style="font-weight:700;font-size:19px;margin-bottom:8px;">Familiarity</div>
        <p class="cs-info-p" style="font-size:15px;">A familiar UI that’s easy to pick up, echoing the apps users already reach for every day.</p>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="cs-wrap cs-divide" style="padding:48px 40px 80px;">
    <div class="cs-eyebrow">(05) — Process</div>
    <h2 class="cs-h2" style="margin:0 0 28px;max-width:20ch;">Flows, trees, and ruthless editing</h2>

    <div class="cs-grid-2" style="align-items:start;gap:40px;margin-bottom:36px;">
      <div>
        <h3 class="cs-h3" style="font-size:21px;margin:0 0 10px;">User flows &amp; IA</h3>
        <p style="font-size:16px;line-height:1.58;color:var(--color-navy-strong);margin:0;">I mapped out the app’s flows and page labeling, then ran a remote-moderated tree-test study to validate the information architecture before moving into wireframes.</p>
      </div>
      <div>
        <h3 class="cs-h3" style="font-size:21px;margin:0 0 10px;">Wireframe &amp; prototype</h3>
        <p style="font-size:16px;line-height:1.58;color:var(--color-navy-strong);margin:0;">I tested what was essential and cut the rest. A remote usability study confirmed my worry, some pages felt overwhelming with too many on-screen elements, so I revised toward less clutter and clearer navigation.</p>
      </div>
    </div>

    <div style="border-radius:18px;padding:clamp(20px,3vw,38px);background:#ECE7D6;border:1px solid rgb(23 36 63 / .1);margin-bottom:24px;">
      <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--color-accent);margin-bottom:20px;">Information architecture · tree-tested</div>
      <div style="border-radius:12px;overflow:hidden;border:1px solid rgb(23 36 63 / .1);background:#F7F2E6;">
        <img src={`${B}/sitemap.svg`} alt="App sitemap: Onboarding branches to Log In and Register, leading to Homepage, which branches into Tracker/journal, Post/feed, and Profile" style="display:block;width:100%;height:auto;" />
      </div>
    </div>

    <div style="border-radius:18px;padding:clamp(20px,3vw,38px);background:#ECE7D6;border:1px solid rgb(23 36 63 / .1);">
      <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--color-accent);margin-bottom:18px;">Wireframe → final · Profile screen</div>
      <p style="font-size:16px;line-height:1.6;color:var(--color-navy-strong);margin:0 0 26px;max-width:80ch;">Early designs centered on personal habit tracking, with a dedicated Habits tab for individual progress. Through research and testing, the concept shifted: habits alone are personal, but shared habits become bonds. Renaming the tab and reframing the core action around Bonds reflected that the app's real value is what happens between people, not just within them.</p>
      <div class="cs-grid-2" style="align-items:start;gap:24px;">
        <figure style="margin:0;">
          <div style="border-radius:12px;overflow:hidden;border:1px solid rgb(23 36 63 / .12);background:#fff;">
            <img src={`${B}/wireframe-profile.png`} alt="Wireframe of the Profile screen" style="display:block;width:100%;height:auto;" />
          </div>
          <figcaption class="cs-figcap">Wireframe — Habits tab, list-based profile</figcaption>
        </figure>
        <figure style="margin:0;">
          <div style="border-radius:12px;overflow:hidden;border:1px solid rgb(23 36 63 / .12);background:#fff;">
            <img src={`${B}/final-profile.png`} alt="Final hi-fi Profile screen" style="display:block;width:100%;height:auto;" />
          </div>
          <figcaption class="cs-figcap">Final — Bonds tab, Shared Bonds front and center</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- DESIGN SYSTEM -->
  <section class="cs-wrap cs-divide" style="padding:48px 40px 80px;">
    <div class="cs-eyebrow">(06) — Design system</div>
    <h2 class="cs-h2" style="margin:0 0 24px;max-width:20ch;">Warm, inviting, and consistent</h2>
    <p style="font-size:18px;line-height:1.62;color:var(--color-navy-strong);margin:0 0 36px;max-width:62ch;">I distilled my research into a small, familiar system built for daily use — an inviting palette, a clear type hierarchy, and a set of reusable components that keep every screen consistent.</p>

    <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--color-navy-subtle);margin-bottom:16px;">Color</div>
    <div class="cs-grid-4" style="margin-bottom:44px;">
      <div><div style="height:120px;border-radius:14px;background:#EFE7D7;border:1px solid rgb(23 36 63 / .12);"></div><div class="cs-swatch-l">Warm neutral</div></div>
      <div><div style="height:120px;border-radius:14px;background:#fc8207;"></div><div class="cs-swatch-l">Energetic orange</div></div>
      <div><div style="height:120px;border-radius:14px;background:#5b9797;"></div><div class="cs-swatch-l">Calming teal</div></div>
      <div><div style="height:120px;border-radius:14px;background:#1e1e1e;"></div><div class="cs-swatch-l">Ink</div></div>
    </div>

    <div style="display:flex;flex-direction:column;gap:20px;">
      <!-- Type scale (full-width, horizontal) -->
      <div style="border-radius:18px;padding:clamp(22px,3vw,34px);background:#fff9f2;border:1px solid rgb(23 36 63 / .07);box-shadow:0 1px 2px rgb(23 36 63 / .04),0 16px 38px -20px rgb(23 36 63 / .22);">
        <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--color-accent);margin-bottom:30px;">Type · SF Pro, weight-driven</div>
        <div style="font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text',system-ui,sans-serif;color:#1e1e1e;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:28px 32px;align-items:end;">
          <div>
            <div style="font-size:34px;font-weight:700;line-height:1;letter-spacing:-.01em;">68 days</div>
            <div style="font-family:var(--font-mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--color-navy-subtle);margin-top:14px;">Display · 30–40 / Bold</div>
          </div>
          <div>
            <div style="font-size:18px;font-weight:600;">Shared Bonds</div>
            <div style="font-family:var(--font-mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--color-navy-subtle);margin-top:14px;">Heading · 18 / Semibold</div>
          </div>
          <div>
            <div style="font-size:15px;font-weight:400;color:#707070;">Daily check-in</div>
            <div style="font-family:var(--font-mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--color-navy-subtle);margin-top:14px;">Body · 15 / Regular</div>
          </div>
          <div>
            <div style="font-size:12px;font-weight:500;letter-spacing:.02em;color:#817065;">Most Consistent</div>
            <div style="font-family:var(--font-mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--color-navy-subtle);margin-top:14px;">Label · 12 / Medium</div>
          </div>
        </div>
      </div>

      <!-- Core components (full-width, horizontal) -->
      <div style="border-radius:18px;padding:clamp(22px,3vw,34px);background:#fff9f2;border:1px solid rgb(23 36 63 / .07);box-shadow:0 1px 2px rgb(23 36 63 / .04),0 16px 38px -20px rgb(23 36 63 / .22);">
        <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--color-accent);margin-bottom:30px;">Core components</div>
        <div style="font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text',system-ui,sans-serif;display:flex;flex-wrap:wrap;gap:30px 28px;align-items:flex-end;">
          <div>
            <span style="background:#e6e1da;color:#1e1e1e;border-radius:999px;padding:7px 15px;font-size:14px;font-weight:700;display:inline-flex;align-items:center;gap:7px;line-height:1;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#fc8207" stroke="#fc8207" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
              68
            </span>
